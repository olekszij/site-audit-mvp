<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Отчёт аудита: <%= targetUrl %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
    <%
        const levelStyles = {
            success: 'border-emerald-400/40 bg-emerald-400/10 text-emerald-100',
            warning: 'border-amber-400/40 bg-amber-400/10 text-amber-100',
            danger: 'border-red-400/40 bg-red-400/10 text-red-100',
            info: 'border-sky-400/40 bg-sky-400/10 text-sky-100'
        };
        const levelLabels = {
            success: 'OK',
            warning: 'Внимание',
            danger: 'Критично',
            info: 'Инфо'
        };
        const levelDots = {
            success: 'bg-emerald-300',
            warning: 'bg-amber-300',
            danger: 'bg-red-300',
            info: 'bg-sky-300'
        };
        const titleLength = raw.title ? raw.title.length : 0;
        const descriptionLength = raw.description ? raw.description.length : 0;
    %>

    <main class="mx-auto w-full max-w-7xl px-5 py-8 sm:px-8">
        <header class="mb-6 flex flex-col gap-4 border-b border-zinc-800 pb-6 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <a href="/" class="text-sm font-medium text-cyan-300 transition hover:text-cyan-200">← Новый аудит</a>
                <h1 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Результаты аудита</h1>
                <p class="mt-3 max-w-4xl break-all text-sm text-zinc-300">
                    <span class="text-zinc-500">Проверенный URL:</span>
                    <a href="<%= finalUrl %>" target="_blank" class="text-cyan-300 hover:text-cyan-200"><%= finalUrl %></a>
                </p>
            </div>
            <div class="rounded-lg border border-zinc-800 bg-zinc-900 px-5 py-4">
                <p class="text-sm text-zinc-400">Итоговый балл</p>
                <p class="mt-1 text-4xl font-semibold text-white"><%= summary.score %><span class="text-base text-zinc-500">/100</span></p>
            </div>
        </header>

        <section class="mb-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
                <p class="text-sm text-zinc-400">Критично</p>
                <p class="mt-1 text-2xl font-semibold text-red-200"><%= summary.danger %></p>
            </div>
            <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
                <p class="text-sm text-zinc-400">Внимание</p>
                <p class="mt-1 text-2xl font-semibold text-amber-200"><%= summary.warning %></p>
            </div>
            <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
                <p class="text-sm text-zinc-400">OK</p>
                <p class="mt-1 text-2xl font-semibold text-emerald-200"><%= summary.success %></p>
            </div>
            <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
                <p class="text-sm text-zinc-400">Время ответа</p>
                <p class="mt-1 text-2xl font-semibold text-white"><%= loadTime %> мс</p>
            </div>
            <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
                <p class="text-sm text-zinc-400">Проверено</p>
                <p class="mt-1 text-sm font-medium text-zinc-200"><%= checkedAt %></p>
            </div>
        </section>

        <section class="mb-8 grid gap-4 lg:grid-cols-2">
            <article class="rounded-lg border border-zinc-800 bg-zinc-900 p-5">
                <div class="flex items-center justify-between gap-3">
                    <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-cyan-300">Title</h2>
                    <span class="rounded-full border border-zinc-700 px-2.5 py-1 text-xs text-zinc-300"><%= titleLength %> симв.</span>
                </div>
                <p class="mt-3 break-words text-base leading-7 text-white"><%= raw.title || 'Title отсутствует' %></p>
            </article>

            <article class="rounded-lg border border-zinc-800 bg-zinc-900 p-5">
                <div class="flex items-center justify-between gap-3">
                    <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-cyan-300">Meta description</h2>
                    <span class="rounded-full border border-zinc-700 px-2.5 py-1 text-xs text-zinc-300"><%= descriptionLength %> симв.</span>
                </div>
                <p class="mt-3 break-words text-base leading-7 text-white"><%= raw.description || 'Meta description отсутствует' %></p>
            </article>
        </section>

        <section class="mb-8 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
            <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
                <p class="text-sm text-zinc-400">Ссылки</p>
                <p class="mt-1 text-xl font-semibold text-white"><%= raw.internalLinks %> / <%= raw.externalLinks %></p>
                <p class="mt-1 text-xs text-zinc-500">внутренние / внешние</p>
            </div>
            <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
                <p class="text-sm text-zinc-400">Картинки без alt</p>
                <p class="mt-1 text-xl font-semibold text-white"><%= raw.imagesWithoutAlt %> + <%= raw.imagesWithEmptyAlt %></p>
                <p class="mt-1 text-xs text-zinc-500">отсутствует + пустой</p>
            </div>
            <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
                <p class="text-sm text-zinc-400">JS / CSS</p>
                <p class="mt-1 text-xl font-semibold text-white"><%= raw.scripts %> / <%= raw.stylesheets %></p>
                <p class="mt-1 text-xs text-zinc-500">внешние файлы</p>
            </div>
            <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
                <p class="text-sm text-zinc-400">HTML / текст</p>
                <p class="mt-1 text-xl font-semibold text-white"><%= raw.htmlSize %> / <%= raw.wordCount %></p>
                <p class="mt-1 text-xs text-zinc-500">размер / слов</p>
            </div>
        </section>

        <section class="grid gap-4 xl:grid-cols-[1fr_360px]">
            <div class="space-y-3">
                <% insights.forEach(item => { %>
                    <article class="rounded-lg border p-4 <%= levelStyles[item.level] %>">
                        <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                            <div>
                                <div class="mb-2 flex flex-wrap items-center gap-2">
                                    <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-black/20 px-2.5 py-1 text-xs font-semibold">
                                        <span class="h-2 w-2 rounded-full <%= levelDots[item.level] %>"></span>
                                        <%= levelLabels[item.level] %>
                                    </span>
                                    <span class="rounded-full border border-white/10 bg-black/20 px-2.5 py-1 text-xs font-medium text-zinc-200"><%= item.category %></span>
                                </div>
                                <h2 class="text-base font-semibold text-white"><%= item.title %></h2>
                                <p class="mt-1 text-sm leading-6 text-zinc-200"><%= item.text %></p>
                            </div>
                        </div>
                        <% if (item.details && item.details.length) { %>
                            <ul class="mt-3 space-y-1 border-t border-white/10 pt-3 text-xs leading-5 text-zinc-300">
                                <% item.details.forEach(detail => { %>
                                    <li class="break-all"><%= detail %></li>
                                <% }) %>
                            </ul>
                        <% } %>
                    </article>
                <% }) %>
            </div>

            <aside class="space-y-3">
                <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
                    <h2 class="text-sm font-semibold text-white">Сырые данные</h2>
                    <dl class="mt-3 space-y-2 text-sm">
                        <div class="flex justify-between gap-3">
                            <dt class="text-zinc-500">HTTP статус</dt>
                            <dd class="text-right text-zinc-200"><%= raw.status %></dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-zinc-500">Content-Type</dt>
                            <dd class="text-right text-zinc-200"><%= raw.contentType %></dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-zinc-500">Редиректы</dt>
                            <dd class="text-right text-zinc-200"><%= raw.redirects.length %></dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-zinc-500">Canonical</dt>
                            <dd class="max-w-48 break-all text-right text-zinc-200"><%= raw.canonical || 'Нет' %></dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-zinc-500">Robots meta</dt>
                            <dd class="max-w-48 break-all text-right text-zinc-200"><%= raw.robots || 'Нет' %></dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-zinc-500">Sitemap</dt>
                            <dd class="text-right text-zinc-200"><%= raw.sitemap.exists ? 'Найден' : 'Нет' %></dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-zinc-500">JSON-LD</dt>
                            <dd class="text-right text-zinc-200"><%= raw.jsonLd %></dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-zinc-500">hreflang</dt>
                            <dd class="text-right text-zinc-200"><%= raw.hreflang %></dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-zinc-500">Сжатие</dt>
                            <dd class="text-right text-zinc-200"><%= raw.compression || 'Нет' %></dd>
                        </div>
                    </dl>
                </div>

                <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
                    <h2 class="text-sm font-semibold text-white">Title</h2>
                    <p class="mt-2 break-words text-sm leading-6 text-zinc-300"><%= raw.title || 'Нет' %></p>
                    <h2 class="mt-4 text-sm font-semibold text-white">Meta description</h2>
                    <p class="mt-2 break-words text-sm leading-6 text-zinc-300"><%= raw.description || 'Нет' %></p>
                    <h2 class="mt-4 text-sm font-semibold text-white">H1</h2>
                    <p class="mt-2 break-words text-sm leading-6 text-zinc-300"><%= raw.h1.length ? raw.h1.join(' | ') : 'Нет' %></p>
                </div>
            </aside>
        </section>
    </main>
</body>
</html>
